# ── توجيه كل الطلبات لـ index.html (SPA) ──────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # كل تطبيق PWA له صفحة دخول خاصة تحمل بطاقة تعريفه ووسوم iOS.
  # بدونها يقرأ iOS البطاقة العامة (start_url:"/") فتفتح الأيقونة الموقع لا التطبيق.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(buy|proj|qc)(/.*)?$ /$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── منع كاش index.html ─────────────────────────────────────────
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</Files>

# ── عامل الخدمة وبطاقات التعريف: بلا كاش إطلاقاً ───────────────
# قاعدة الكاش الطويل أدناه تشمل كل ملفات JS، وكانت تحبس sw.js في المتصفح
# أسبوعاً كاملاً فيبقى التطبيق على نسخته القديمة رغم النشر.
<FilesMatch "^(sw\.js|service-worker\.js|registerSW\.js|workbox-[^/]+\.js)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>
<FilesMatch "\.webmanifest$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# ── نوع MIME الصحيح لملفات WebAssembly (قارئ DWG) ─────────────
AddType application/wasm .wasm

# ── نوع بطاقة تعريف التطبيق ────────────────────────────────────
# كانت تُقدَّم text/plain فيفشل التثبيت على أندرويد بصمت بعد «جاري التثبيت»
AddType application/manifest+json .webmanifest

# ── الفيديو: كاش قصير ────────────────────────────────────────
# اسمه ثابت بلا hash، فالكاش الطويل يجمّد النسخة القديمة عند أي استبدال.
<FilesMatch "\.(mp4|webm|mov)$">
  Header set Cache-Control "public, max-age=300, must-revalidate"
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

# ── كاش طويل لملفات الأصول (لها hash في اسمها) ────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>
